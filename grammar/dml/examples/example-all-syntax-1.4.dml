method testSwitch() {
    switch (VAL) {
    case 1:
    case 2:
        {
            local int val;
            return;
        }
    case PRARAM:
    case CONST:
        val = 123;
        break;
    case IF_FALLTHRUE_1:
    #if (false) {
    case 3:
    case 3:
        {
            local int val;
            return;
        }
    case PRARAM + 2:
    case CONST + 2:
        val = 123;
        break;
    case IF_FALLTHRUE_2:
    } #else {
    case 3:
    case 3:
        {
            local int val;
            return;
        }
    case PRARAM + 2:
    case CONST + 2:
        val = 123;
        break;
    case IF_FALLTHRUE_3:
    }
    case 321:
    default:
        val = "wer";
        break;
    }
}


