constant unmapped_offset = 0xffff_ffff_ffff_ffff;
constant unmapped_offset = 0b1111_0000_1111;


bank BANK {
    param register_size = 4;

    implement IMPLEMENT_BANK {
    }

    connect CONNECT_BANK {
        interface INTERFACE_BANK {
        }
    }

    attribute ATTRIBUTE_BANK {
    }

    register R {
        field F {
        }
    }

    register r1_s4 {
        param size = 4;
    }

    register r1_s4_inline size 4 {
    }

    register r1_addr_inline @ 0x0100;
    register r1_addr_size size 4 @ 0x0100;
    register r is (unmapped);

    register rf {
        field status @ [2:0];
        field flags @ [8:3];
        field reserved @ [15:9];
    }

    group blocks[i < 8] {
        register r1 @ i * 32 + 0;
        register r2 @ i * 32 + 4;
        register r3[j < 6] @ i * 32 + 8 + j * 4;
    }
}


template weird {
    param group_offset;

    register a size 4 @ group_offset is (read, write);

    register b size 4 @ group_offset + 4 is (read, write) {
        method read() -> (uint64) {
            // When register b is read, return a
            return a.val;
        }
    }
}


bank regs {
    group block_a is (weird) {
        param group_offset = 128;
    }

    group block_b is (weird) {
        param group_offset = 1024;
    }
}


bank regs {
    param register_size = 4;

    group blocks[i < 8] {
        register r1 @ i * 52 + 0;

        group sub_blocks[j < 4] {
            register r2 @ i * 52 + j * 12 + 4;
            register r3[k < 3] @ i * 52 + j * 12 + k * 4 + 8;
        }
    }

    in each field {
        is write;
    }

    in each register {
        param size = 2;
    }

    register r0 size 2 @ 0x0000 is (constant) {
        param value = 0xffff;
    }

    register r2 @ 0x0100 "general-purpose register 0" {
    }

    register r2 @ 0x0100 is (read, write) "general-purpose register 0";

    register r4 @ 0x0100 is (read, write) "general-purpose register 0" {
    }

    #if (modeltype == "Mark I") {
        register R size 4;
    } #else #if (modeltype == "Mark II") {
        register R size 2;
    } #else {
        register R size 1;
    }
}


