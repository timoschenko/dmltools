method testSwitchStatementsAfterHashIf() {
    switch (cmd) {
    case CMD_RESET:
        reset_device();
        break;
    #if (ENABLE_FEATURE_A) {
    case CMD_EXEC_A:
        execute_a();
    } #else {
    case CMD_EXEC_B:
        execute_b();
    }
        log info, 1, 0: "Command executed";
        break;
    default:
        log error, 1, 0: "Unknown command: %d",
            cmd;
        break;
    }
}


method testSwitchHashIfFallthrough() {
    switch (status) {
    case STATUS_IDLE:
        break;
    case STATUS_BUSY:
    #if (HAS_SPECIAL_MODE_1) {
    case STATUS_SPECIAL_1:
    }
    #if (HAS_SPECIAL_MODE_2) {
    case STATUS_SPECIAL_2:
    }
        common_busy_handler();
        break;
    default:
        break;
    }
}


method testSwitchNested() {
    switch (mode) {
    case MODE_NORMAL:
        switch (submode) {
        case 0:
            val = 0;
            break;
        case 1:
            val = 1;
            break;
        default:
            val = -1;
            break;
        }
        break;
    case MODE_DIRECT:
        val = direct_val;
        break;
    default:
        break;
    }
}


