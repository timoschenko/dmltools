method control_flow_statements() {
    local int val = 5;

    while (val > 0) {
        val--;
    }

    do {
        val++;
    } while (val < 10);

    try {
        throw;
    } catch {
        log info: "caught exception";
    }

    assert (val >= 0);

    goto end_label;

    warning "This feature is deprecated";
    warning ("Parenthesized warning message");

    local list_t num_list = [1, 2, 3];
    select item in (num_list) where (item > 0) {
        log info: "found %d",
            item;
    } else {
        log info: "not found";
    }

    #select citem in ([10, 20]) where (citem > 15) {
        log info: "const selected %d",
            citem;
    } #else {
        log info: "const not found";
    }
}


method expressions_and_slices() {
    local typeof(1 + 2) var_typeof = 3;
    local uint32 slice_val = 0x12345678;
    local uint8 byte0 = slice_val[7:0];
    local uint8 byte1 = slice_val[15:8, be];
    local uint8 bit_endian = slice_val[3, le];

    slice_val += 1;
    slice_val -= 1;
    slice_val *= 2;
    slice_val /= 2;
    slice_val %= 2;
    slice_val |= 4;
    slice_val &= 0xff;
    slice_val ^= 2;
    slice_val <<= 1;
    slice_val >>= 1;

    local int sz1 = sizeoftype uint32;
    local int sz2 = sizeoftype(struct_t);

    local list_t empty_list = [];
    local list_t num_list = [1, 2, 3];
    local int first_item = num_list[0];
    local int ternary_val = (first_item > 0) ? 100 : 200;

    (sz1, sz2) = (10, 20);
}


